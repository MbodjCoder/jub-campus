# ─────────────────────────────────────────────────────────────
# JUB Campus — variables d'environnement
# Copier vers .env.local et remplir avant de lancer pnpm dev.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Neon recommandé en prod)
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/jub_campus?schema=public"

# Environnement métier JUB : development | preview | production
JUB_ENV="development"

# Auth.js v5 (générer avec : openssl rand -base64 32)
AUTH_SECRET="changer_avec_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# OAuth Google (console.cloud.google.com → identifiants OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email transactionnel (resend.com)
RESEND_CLE_API=""
EMAIL_EXPEDITEUR="JUB Campus <hello@updates.jubcampus.sn>"
EMAIL_CONTACT="contact@jubcampus.sn"

# Stockage fichiers — Supabase Storage (sinon repli disque local)
# Créer 2 buckets dans Supabase → Storage :
#   medias-public  → PUBLIC  (photos de profil)
#   medias-prive   → PRIVÉ   (livrables, certificats — accès URL signée)
SUPABASE_URL=""
SUPABASE_CLE_SERVICE=""
SUPABASE_BUCKET_PUBLIC="medias-public"
SUPABASE_BUCKET_PRIVE="medias-prive"

# URL publique du site (pour QR certificats + emails)
URL_PUBLIQUE="http://localhost:3000"

# Ne jamais activer en production.
AUTORISER_CERTIFICAT_DEMO="false"
